#!/bin/sh
# Install GitHub's CLI from the .deb they publish.
#
# `gh` is not in Debian. The copilot component declared PACKAGES="gh" for
# months, which meant `strata install copilot` would have failed on an apt error
# — a package assumed to exist and never checked, the same way upower, hypridle
# and hyprlock were assumed to work.
#
# GitHub also publishes an APT repository. ADR-0011 refuses those on purpose: a
# repository's signing key is trusted for every package name, including
# replacements for system components. A single .deb grants nothing beyond
# itself, so that is what is fetched here.
#
# The version is resolved from the releases API rather than pinned, because a
# pinned one rots and this is not part of the reproducible image (ADR-0005
# covers the image, not what someone installs afterwards).

set -eu

arch="$(dpkg --print-architecture)"
api="https://api.github.com/repos/cli/cli/releases/latest"

printf 'Resolving the latest gh release...\n'
url="$(curl -fsSL "$api" \
	| grep -oE '"browser_download_url": "[^"]*_linux_'"$arch"'\.deb"' \
	| head -1 | cut -d'"' -f4)"

[ -n "$url" ] || { printf 'Could not find a .deb for %s in the latest release.\n' "$arch" >&2; exit 1; }

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

printf 'Fetching %s\n' "$url"
curl -fsSL -o "$tmp/gh.deb" "$url"

printf 'Installing\n'
sudo apt-get install -y "$tmp/gh.deb"
