#!/bin/bash
# Write one colour scheme out to every application that has its own idea of how
# colours are configured.
#
# Nothing here invents a colour. The scheme file is the only source; this script
# translates it into five dialects:
#
#   Quickshell   a QML singleton               /etc/xdg/quickshell/Colors.qml
#   foot         ini fragment, hex, no #       /etc/strata/theme/foot.ini
#   fuzzel       ini, 8-digit RRGGBBAA         /etc/xdg/fuzzel/fuzzel.ini
#   mako         ini, #RRGGBB                  /etc/strata/theme/mako.conf
#   Hyprland     Lua table, rgba(RRGGBBAA)     /etc/strata/theme/colors.lua
#
# Applications that support an include are given one, so a user's own settings
# survive a theme change. Where no include exists — fuzzel — the whole file is
# generated, and that is stated in the file itself.
#
# Usage: apply-theme [/path/to/scheme.theme]
#        with no argument the active scheme is used.

# The base00..base0F values are read from the scheme file at runtime, so no
# assignment for them exists here to be found.
# shellcheck disable=SC2154
set -euo pipefail

readonly ACTIVE="/etc/strata/theme/active.theme"
readonly OUT="/etc/strata/theme"

die() { printf '\033[1;31m==> ERROR:\033[0m %s\n' "$*" >&2; exit 1; }

scheme="${1:-$ACTIVE}"
[[ -r "$scheme" ]] || die "no readable scheme at ${scheme}"

# The scheme is data, not code. Refuse anything that is not a plain assignment
# rather than sourcing whatever happens to be in the file.
if grep -qvE '^\s*(#.*)?$|^\s*[A-Za-z_][A-Za-z0-9_]*="?[#A-Za-z0-9 _-]*"?\s*(#.*)?$' "$scheme"; then
	die "${scheme} contains something that is not a simple assignment"
fi
# shellcheck disable=SC1090  # the path is the argument, by design
source "$scheme"

for v in base00 base01 base02 base03 base04 base05 base06 base07 \
         base08 base09 base0A base0B base0C base0D base0E base0F; do
	[[ -n "${!v:-}" ]] || die "${scheme} is missing ${v}"
done

mkdir -p "$OUT"

is_dark=true
[[ "${VARIANT:-dark}" == "light" ]] && is_dark=false

# ---- Quickshell -----------------------------------------------------------
# Generated rather than hand-edited, so Theme.qml can stay a readable file of
# names and spacing while the colours come from the scheme.
cat > "${OUT}/Colors.qml" <<EOF
pragma Singleton
// Generated by /usr/lib/strata/apply-theme from ${NAME:-$scheme}.
// Edits here are lost on the next theme change; edit the scheme instead.
import Quickshell
import QtQuick

Singleton {
    readonly property string name:    "${NAME:-unnamed}"
    readonly property bool   isDark:  ${is_dark}

    readonly property color base00: "#${base00}"
    readonly property color base01: "#${base01}"
    readonly property color base02: "#${base02}"
    readonly property color base03: "#${base03}"
    readonly property color base04: "#${base04}"
    readonly property color base05: "#${base05}"
    readonly property color base06: "#${base06}"
    readonly property color base07: "#${base07}"
    readonly property color base08: "#${base08}"
    readonly property color base09: "#${base09}"
    readonly property color base0A: "#${base0A}"
    readonly property color base0B: "#${base0B}"
    readonly property color base0C: "#${base0C}"
    readonly property color base0D: "#${base0D}"
    readonly property color base0E: "#${base0E}"
    readonly property color base0F: "#${base0F}"
}
EOF
ln -sfn "${OUT}/Colors.qml" /etc/xdg/quickshell/Colors.qml

# ---- foot -----------------------------------------------------------------
# base16's terminal mapping, which is what makes an existing scheme look the way
# its author intended in a terminal.
# foot replaced [colors] with [colors-dark] and [colors-light], and warns once
# per key if the old name is used — a wall of deprecation lines on every single
# terminal launch. Both sections get the same values on purpose: Strata applies
# one scheme explicitly, so foot must not second-guess it based on what it
# believes the system appearance to be.
{
	printf '# Generated by /usr/lib/strata/apply-theme from %s.\n' "${NAME:-$scheme}"
	printf '# Included by /etc/xdg/foot/foot.ini — your own settings there are untouched.\n'
	for section in colors-dark colors-light; do
		cat <<EOF
[${section}]
background=${base00}
foreground=${base05}
regular0=${base00}
regular1=${base08}
regular2=${base0B}
regular3=${base0A}
regular4=${base0D}
regular5=${base0E}
regular6=${base0C}
regular7=${base05}
bright0=${base03}
bright1=${base08}
bright2=${base0B}
bright3=${base0A}
bright4=${base0D}
bright5=${base0E}
bright6=${base0C}
bright7=${base07}
selection-background=${base02}
selection-foreground=${base05}
EOF
	done
} > "${OUT}/foot.ini"

# ---- fuzzel ---------------------------------------------------------------
# No include directive exists, so the file is generated whole. The terminal line
# is not cosmetic: without it Terminal=true desktop entries silently do nothing.
cat > /etc/xdg/fuzzel/fuzzel.ini <<EOF
# Generated by /usr/lib/strata/apply-theme from ${NAME:-$scheme}.
# fuzzel has no include directive, so this whole file is regenerated on a theme
# change. Put your own settings in ~/.config/fuzzel/fuzzel.ini, which wins.
[main]
terminal=foot -e
prompt=> 
icons-enabled=yes
line-height=20
horizontal-pad=16
vertical-pad=12
inner-pad=8

[border]
radius=10
width=1

[colors]
background=${base00}f2
text=${base05}ff
match=${base0D}ff
selection=${base02}ff
selection-text=${base06}ff
selection-match=${base0D}ff
border=${base02}ff
prompt=${base04}ff
placeholder=${base03}ff
input=${base05}ff
counter=${base03}ff
EOF

# ---- mako -----------------------------------------------------------------
cat > "${OUT}/mako.conf" <<EOF
# Generated by /usr/lib/strata/apply-theme from ${NAME:-$scheme}.
background-color=#${base01}
text-color=#${base05}
border-color=#${base02}
progress-color=over #${base0D}
border-radius=10
border-size=1
padding=10
# Wide enough for a service name plus what to do about it; the default of 300
# elided the useful half of Strata's own session warning.
width=420
default-timeout=6000
font=Inter Variable 10

[urgency=high]
border-color=#${base08}
default-timeout=0
EOF

# ---- GTK --------------------------------------------------------------------
#
# Two files, because GTK reads them from two different places and only one of
# them is system-wide.
#
# settings.ini is read from XDG_CONFIG_DIRS, so /etc/xdg reaches every user —
# measured, not assumed: Thunar came up dark from this file alone. It carries
# the dark preference and the interface font.
#
# gtk.css is read only from XDG_CONFIG_HOME, never from XDG_CONFIG_DIRS, so
# there is no system-wide place for it. It goes to /etc/skel for accounts not
# yet created, and `strata theme set` copies it into the home of whoever ran it.
# Colours therefore follow a theme change for the user who made it; a second
# user on the same machine keeps theirs until they switch too.
mkdir -p /etc/xdg/gtk-3.0 /etc/xdg/gtk-4.0 \
         /etc/skel/.config/gtk-3.0 /etc/skel/.config/gtk-4.0

for d in /etc/xdg/gtk-3.0 /etc/xdg/gtk-4.0; do
	cat > "${d}/settings.ini" <<EOF
# Generated by /usr/lib/strata/apply-theme from ${NAME:-$scheme}.
[Settings]
gtk-application-prefer-dark-theme=${is_dark}
gtk-theme-name=Adwaita
gtk-icon-theme-name=Adwaita
gtk-font-name=Inter Variable 10
gtk-cursor-theme-size=24
EOF
done

# The named colours below are what an *application* asks for by hand. They are
# not what the theme paints itself with: Adwaita's own sheet is compiled from
# its own palette, so redefining these left Thunar in Adwaita grey with GNOME
# blue selections. Measured on hardware — the selected row was #3584e4 when the
# scheme says #7aa2f7 — and fixed by the rules further down, which name real
# widgets. The definitions still earn their place: applications that do use
# them get the right colours, and the rules below are written in terms of them.
gtk_colors() {
	cat <<EOF
/* Generated by /usr/lib/strata/apply-theme from ${NAME:-$scheme}. */
@define-color theme_bg_color #${base00};
@define-color theme_base_color #${base00};
@define-color theme_fg_color #${base05};
@define-color theme_text_color #${base05};
@define-color theme_selected_bg_color #${base0D};
@define-color theme_selected_fg_color #${base00};
@define-color insensitive_bg_color #${base01};
@define-color insensitive_fg_color #${base03};
@define-color borders #${base02};
@define-color warning_color #${base0A};
@define-color error_color #${base08};
@define-color success_color #${base0B};
@define-color accent_color #${base0D};
@define-color accent_bg_color #${base0D};
@define-color accent_fg_color #${base00};
@define-color strata_raised #${base01};
@define-color strata_hover #${base02};
@define-color strata_dim #${base03};
EOF
}

# GTK 3 only. These are widget names, and GTK 4's are different enough that the
# same sheet would style the wrong things — libadwaita is handled by name below
# instead, which is the mechanism it actually supports.
#
# Deliberately a short list: the surfaces a file manager shows. Restyling every
# widget state by hand is how a hand-written GTK theme becomes a second project,
# and anything not named here keeps Adwaita's behaviour rather than breaking.
gtk3_rules() {
	cat <<'EOF'

window, dialog, .background, paned, box {
	background-color: @theme_bg_color;
	color: @theme_fg_color;
}

headerbar, .titlebar, menubar, toolbar, .toolbar, statusbar, actionbar {
	background-image: none;
	background-color: @theme_bg_color;
	color: @theme_fg_color;
	border-color: @borders;
}

menu, .menu, popover, popover.background, .context-menu {
	background-color: @strata_raised;
	color: @theme_fg_color;
	border: 1px solid @borders;
}
menuitem:hover, menu menuitem:hover, modelbutton:hover {
	background-color: @strata_hover;
	color: @theme_fg_color;
}

treeview.view, list, iconview, .view, textview text, scrolledwindow {
	background-color: @theme_base_color;
	color: @theme_fg_color;
}
treeview.view:selected, list row:selected, iconview:selected, .view:selected,
treeview.view:selected:focus, list row:selected:focus,
flowbox flowboxchild:selected {
	background-color: @theme_selected_bg_color;
	color: @theme_selected_fg_color;
}
treeview.view:hover, list row:hover { background-color: @strata_hover; }

.sidebar, placessidebar, placessidebar list, .sidebar list {
	background-color: @strata_raised;
	color: @theme_fg_color;
}

entry, spinbutton, searchbar entry {
	background-color: @strata_raised;
	background-image: none;
	color: @theme_fg_color;
	border-color: @borders;
}
entry:focus { border-color: @accent_color; }

button {
	background-image: none;
	background-color: @strata_raised;
	color: @theme_fg_color;
	border-color: @borders;
}
button:hover { background-color: @strata_hover; }
button:active, button:checked {
	background-color: @accent_bg_color;
	color: @accent_fg_color;
}
button.flat { background-color: transparent; border-color: transparent; }
button.flat:hover { background-color: @strata_hover; }

notebook > header { background-color: @theme_bg_color; border-color: @borders; }
notebook > header > tabs > tab:checked { background-color: @strata_raised; }

scrollbar { background-color: @theme_bg_color; border-color: @borders; }
scrollbar slider { background-color: @strata_dim; }
scrollbar slider:hover { background-color: @theme_fg_color; }

paned > separator, separator { background-color: @borders; }
tooltip, tooltip.background { background-color: @strata_raised; color: @theme_fg_color; }
progressbar progress, scale highlight, scale fill { background-color: @accent_bg_color; }
check:checked, radio:checked { background-color: @accent_bg_color; color: @accent_fg_color; }
EOF
}

# GTK 4 with libadwaita does honour named colours for its own painting, which is
# why it needs no rules — but the names are its own, not GTK 3's.
gtk4_colors() {
	cat <<EOF

@define-color window_bg_color #${base00};
@define-color window_fg_color #${base05};
@define-color view_bg_color #${base00};
@define-color view_fg_color #${base05};
@define-color headerbar_bg_color #${base01};
@define-color headerbar_fg_color #${base05};
@define-color popover_bg_color #${base01};
@define-color popover_fg_color #${base05};
@define-color card_bg_color #${base01};
@define-color card_fg_color #${base05};
@define-color dialog_bg_color #${base01};
@define-color dialog_fg_color #${base05};
@define-color sidebar_bg_color #${base01};
@define-color sidebar_fg_color #${base05};
@define-color destructive_bg_color #${base08};
@define-color success_bg_color #${base0B};
@define-color warning_bg_color #${base0A};
EOF
}

{ gtk_colors; gtk3_rules; } > /etc/skel/.config/gtk-3.0/gtk.css
{ gtk_colors; gtk4_colors; } > /etc/skel/.config/gtk-4.0/gtk.css

# ---- Hyprland -------------------------------------------------------------
cat > "${OUT}/colors.lua" <<EOF
-- Generated by /usr/lib/strata/apply-theme from ${NAME:-$scheme}.
return {
    active   = "rgba(${base0D}ee)",
    inactive = "rgba(${base02}aa)",
    shadow   = "rgba(${base00}cc)",
}
EOF

printf '\033[1;34m==>\033[0m Applied %s\n' "${NAME:-$scheme}"
