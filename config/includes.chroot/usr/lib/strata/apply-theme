#!/bin/bash
# Write one colour scheme out to every application that has its own idea of how
# colours are configured.
#
# Nothing here invents a colour. The scheme file is the only source; this script
# translates it into five dialects:
#
#   Quickshell   a QML singleton               /etc/xdg/quickshell/Colors.qml
#   foot         ini fragment, hex, no #       /etc/strata/theme/foot.ini
#   fuzzel       ini, 8-digit RRGGBBAA         /etc/xdg/fuzzel/fuzzel.ini
#   mako         ini, #RRGGBB                  /etc/strata/theme/mako.conf
#   Hyprland     Lua table, rgba(RRGGBBAA)     /etc/strata/theme/colors.lua
#
# Applications that support an include are given one, so a user's own settings
# survive a theme change. Where no include exists — fuzzel — the whole file is
# generated, and that is stated in the file itself.
#
# Usage: apply-theme [/path/to/scheme.theme]
#        with no argument the active scheme is used.

# The base00..base0F values are read from the scheme file at runtime, so no
# assignment for them exists here to be found.
# shellcheck disable=SC2154
set -euo pipefail

readonly ACTIVE="/etc/strata/theme/active.theme"
readonly OUT="/etc/strata/theme"

die() { printf '\033[1;31m==> ERROR:\033[0m %s\n' "$*" >&2; exit 1; }

scheme="${1:-$ACTIVE}"
[[ -r "$scheme" ]] || die "no readable scheme at ${scheme}"

# The scheme is data, not code. Refuse anything that is not a plain assignment
# rather than sourcing whatever happens to be in the file.
if grep -qvE '^\s*(#.*)?$|^\s*[A-Za-z_][A-Za-z0-9_]*="?[#A-Za-z0-9 _-]*"?\s*(#.*)?$' "$scheme"; then
	die "${scheme} contains something that is not a simple assignment"
fi
# shellcheck disable=SC1090  # the path is the argument, by design
source "$scheme"

for v in base00 base01 base02 base03 base04 base05 base06 base07 \
         base08 base09 base0A base0B base0C base0D base0E base0F; do
	[[ -n "${!v:-}" ]] || die "${scheme} is missing ${v}"
done

mkdir -p "$OUT"

is_dark=true
[[ "${VARIANT:-dark}" == "light" ]] && is_dark=false

# ---- Quickshell -----------------------------------------------------------
# Generated rather than hand-edited, so Theme.qml can stay a readable file of
# names and spacing while the colours come from the scheme.
cat > "${OUT}/Colors.qml" <<EOF
pragma Singleton
// Generated by /usr/lib/strata/apply-theme from ${NAME:-$scheme}.
// Edits here are lost on the next theme change; edit the scheme instead.
import Quickshell
import QtQuick

Singleton {
    readonly property string name:    "${NAME:-unnamed}"
    readonly property bool   isDark:  ${is_dark}

    readonly property color base00: "#${base00}"
    readonly property color base01: "#${base01}"
    readonly property color base02: "#${base02}"
    readonly property color base03: "#${base03}"
    readonly property color base04: "#${base04}"
    readonly property color base05: "#${base05}"
    readonly property color base06: "#${base06}"
    readonly property color base07: "#${base07}"
    readonly property color base08: "#${base08}"
    readonly property color base09: "#${base09}"
    readonly property color base0A: "#${base0A}"
    readonly property color base0B: "#${base0B}"
    readonly property color base0C: "#${base0C}"
    readonly property color base0D: "#${base0D}"
    readonly property color base0E: "#${base0E}"
    readonly property color base0F: "#${base0F}"
}
EOF
ln -sfn "${OUT}/Colors.qml" /etc/xdg/quickshell/Colors.qml

# ---- foot -----------------------------------------------------------------
# base16's terminal mapping, which is what makes an existing scheme look the way
# its author intended in a terminal.
# foot replaced [colors] with [colors-dark] and [colors-light], and warns once
# per key if the old name is used — a wall of deprecation lines on every single
# terminal launch. Both sections get the same values on purpose: Strata applies
# one scheme explicitly, so foot must not second-guess it based on what it
# believes the system appearance to be.
{
	printf '# Generated by /usr/lib/strata/apply-theme from %s.\n' "${NAME:-$scheme}"
	printf '# Included by /etc/xdg/foot/foot.ini — your own settings there are untouched.\n'
	for section in colors-dark colors-light; do
		cat <<EOF
[${section}]
background=${base00}
foreground=${base05}
regular0=${base00}
regular1=${base08}
regular2=${base0B}
regular3=${base0A}
regular4=${base0D}
regular5=${base0E}
regular6=${base0C}
regular7=${base05}
bright0=${base03}
bright1=${base08}
bright2=${base0B}
bright3=${base0A}
bright4=${base0D}
bright5=${base0E}
bright6=${base0C}
bright7=${base07}
selection-background=${base02}
selection-foreground=${base05}
EOF
	done
} > "${OUT}/foot.ini"

# ---- fuzzel ---------------------------------------------------------------
# No include directive exists, so the file is generated whole. The terminal line
# is not cosmetic: without it Terminal=true desktop entries silently do nothing.
cat > /etc/xdg/fuzzel/fuzzel.ini <<EOF
# Generated by /usr/lib/strata/apply-theme from ${NAME:-$scheme}.
# fuzzel has no include directive, so this whole file is regenerated on a theme
# change. Put your own settings in ~/.config/fuzzel/fuzzel.ini, which wins.
[main]
terminal=foot -e
prompt=> 
icons-enabled=yes
line-height=20
horizontal-pad=16
vertical-pad=12
inner-pad=8

[border]
radius=10
width=1

[colors]
background=${base00}f2
text=${base05}ff
match=${base0D}ff
selection=${base02}ff
selection-text=${base06}ff
selection-match=${base0D}ff
border=${base02}ff
prompt=${base04}ff
placeholder=${base03}ff
input=${base05}ff
counter=${base03}ff
EOF

# ---- mako -----------------------------------------------------------------
cat > "${OUT}/mako.conf" <<EOF
# Generated by /usr/lib/strata/apply-theme from ${NAME:-$scheme}.
background-color=#${base01}
text-color=#${base05}
border-color=#${base02}
progress-color=over #${base0D}
border-radius=10
border-size=1
padding=10
default-timeout=6000
font=Inter Variable 10

[urgency=high]
border-color=#${base08}
default-timeout=0
EOF

# ---- Hyprland -------------------------------------------------------------
cat > "${OUT}/colors.lua" <<EOF
-- Generated by /usr/lib/strata/apply-theme from ${NAME:-$scheme}.
return {
    active   = "rgba(${base0D}ee)",
    inactive = "rgba(${base02}aa)",
    shadow   = "rgba(${base00}cc)",
}
EOF

printf '\033[1;34m==>\033[0m Applied %s\n' "${NAME:-$scheme}"
