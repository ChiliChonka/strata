# Base utilities that a minimal desktop still needs to be usable and
# recoverable. Kept deliberately short.

# Console text editor, so a broken graphical session is still fixable.
nano

# Administrative access. This must be listed explicitly, not left to arrive as
# someone else's dependency.
#
# Without it sudo is only pulled in by calamares-settings-debian, so after
# installation `apt-get --purge autoremove` considers it orphaned and tries to
# remove it. Debian's sudo refuses to be removed while no root password is set,
# dpkg reports a prerm failure, and the whole installation aborts at the very
# last step with "Package Manager error ... error code 100".
#
# Even setting the installer aside: live-config puts the user in the sudo group,
# and an installed system with neither sudo nor a root password has no route to
# administrative privileges at all.
sudo

# Fetching things over the network from a shell.
ca-certificates
curl

# Filesystem tooling for the ext4 default (ADR-0007).
e2fsprogs

# Required to install Strata, and required for the installed system to boot.
# None of these is pulled in by calamares, and their absence does not show up
# until an installation is actually attempted:
#
#   dosfstools  provides mkfs.fat. The EFI System Partition must be FAT32 by
#               UEFI specification, so without it Calamares creates the ESP and
#               then fails to format it. The error it reports is "failed to
#               create partition", which points at the wrong step entirely.
#   efibootmgr  writes the UEFI boot entry for the installed system.
#   shim-signed and grub-efi-amd64-signed are the Secure Boot chain ADR-0002
#               requires. live-build puts them on the ISO for the live medium,
#               but the installed system needs its own copies — an installation
#               without them produces a system that cannot boot with Secure Boot
#               enabled, which is the project's core requirement.
dosfstools
efibootmgr
shim-signed
grub-efi-amd64-signed

# Time synchronisation.
systemd-timesyncd

# Typography and icons, per ADR-0013. None of these has a dependency.
#
# The variable build of Inter is the same typeface as fonts-inter at a twelfth
# of the size. The Material icon font resolves ligatures, so a bar element names
# the icon it wants — "bluetooth" — instead of carrying a codepoint table.
fonts-inter-variable
fonts-jetbrains-mono
fonts-material-design-icons-iconfont

# Hardware capabilities ADR-0012 requires, selected in ADR-0014.
#
# upower is the one the battery bar element reads through Quickshell. It was
# never installed, so on a laptop with a charged battery the element showed
# nothing — the third case in this project of shipping a program and not the
# thing it needs. Brightness, by contrast, needs no package: logind sets it.
#
# NOTE: no per-cent signs anywhere in this file, comments included. live-build
# feeds these lines through printf, so a stray one is read as a format
# directive, printf gives up, and every line after it is dropped without a
# word. These four packages were declared for a day and never installed because
# the comment above once read "at 63 per cent" with the sign instead.
upower
power-profiles-daemon
bluez
libspa-0.2-bluetooth

# gio and gdbus, both from here.
#
# The live image had this as a dependency of something else, so `browser`
# launched Flatpak applications and the session's health notification could be
# sent. An installed system does not: whatever pulled it in is not there, and
# both features stopped without a word — the browser fell back to
# sensible-browser, which cannot start a Flatpak, and session-check had nothing
# to send with. Declared here so it is installed because Strata wants it, not
# because something else happened to.
libglib2.0-bin
