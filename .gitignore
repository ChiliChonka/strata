# ---------------------------------------------------------------------------
# live-build working tree
#
# live-build runs in the repository root and writes several GB of build state
# next to the sources. None of it belongs in git.
# ---------------------------------------------------------------------------
/.build/
# live-build's lock file, present while a build runs
/.lock
/cache/
/chroot/
# chroot.files, chroot.packages.install, chroot.packages.live
/chroot.*
/binary/
/binary.*
/local/
/tftpboot/
/auto/local*

# live-build generates config/{common,bootstrap,chroot,binary,source} from
# auto/config. Those are generated; the hand-written parts are kept.
/config/*
!/config/package-lists/
!/config/includes.chroot/
!/config/includes.binary/
!/config/includes.installer/
!/config/archives/
!/config/preseed/
!/config/bootloaders/

# live-build symlinks its own default hooks into config/hooks/{normal,live} on
# every `lb config`. They point into /usr/share/live/build/ and are meaningless
# outside a build environment. When Strata adds hooks of its own, they need an
# explicit negation here.
/config/hooks/

# Generated by live-build for --system live: live-boot, live-config,
# live-config-systemd, systemd-sysv. Strata's own lists are strata-*.list.chroot.
/config/package-lists/live.list.chroot

# Copied in by scripts/build.sh when STRATA_TEST_TOOLS=1. The tracked source
# is tests/packages/test-tools.list.chroot; a copy here is build state and
# must never be committed, or every image would become a test image.
/config/package-lists/strata-test-tools.list.chroot

# ---------------------------------------------------------------------------
# Build artifacts
# ---------------------------------------------------------------------------
*.iso
*.img
*.hybrid.iso
*.squashfs
*.zsync
*.contents
*.packages
*.files
*.buildlog
*.log
*.sha256
*.sha512
*.sig
*.asc

# Package manifests are published as release artifacts, not committed.
/manifest-*.txt

# ---------------------------------------------------------------------------
# QEMU test state
# ---------------------------------------------------------------------------
/tests/**/*.qcow2
/tests/**/*.fd
/tests/**/OVMF_VARS*.fd
# screenshots/ and screenshots-install/ alike
/tests/screenshots*/

# ---------------------------------------------------------------------------
# Editors and OS cruft
# ---------------------------------------------------------------------------
*.swp
*~
.DS_Store
/.idea/
/.vscode/
test-screenshots/
